<ContentDialog
    x:Class="Kokoon.UI.Views.AddDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Download"
    PrimaryButtonText="Download Now"
    SecondaryButtonText="Queue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    IsSecondaryButtonEnabled="False"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <!--  ContentDialogMaxWidth must be overridden locally — the default (548) minus
              ContentDialogPadding only leaves 500px for content.  -->
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
    </ContentDialog.Resources>

    <!--  MinWidth accounts for ContentDialogMaxWidth minus the dialog's border and
          padding, so content doesn't clip against the right edge.  -->
    <StackPanel Spacing="16" MinWidth="470">

        <!-- ============================================================ -->
        <!--  URL Input                                                   -->
        <!-- ============================================================ -->
        <StackPanel Spacing="6">
            <TextBlock Text="URL"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="20"
                       Foreground="{ThemeResource TextSecondary}"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlTextBox"
                         Grid.Column="0"
                         PlaceholderText="https://..."
                         FontFamily="Cascadia Code, Consolas"
                         FontSize="12"
                         CornerRadius="8"/>
                <Button Grid.Column="1"
                        Content="Analyze"
                        Foreground="{ThemeResource NeonBlueBrush}"
                        Background="{ThemeResource NeonBlue20}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource CornerRadiusButton}"
                        Padding="16,10"
                        FontWeight="SemiBold"
                        VerticalAlignment="Stretch"
                        Click="AnalyzeButton_Click"/>
            </Grid>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Loading Indicator (while probing)                           -->
        <!-- ============================================================ -->
        <StackPanel x:Name="ProbeLoadingPanel"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Padding="8">
            <ProgressRing IsActive="True"
                          Width="24"
                          Height="24"
                          Foreground="{ThemeResource NeonBlueBrush}"/>
            <TextBlock Text="Analyzing URL..."
                       Style="{StaticResource BodyTextStyle}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Error Message (shown on probe failure)                      -->
        <!-- ============================================================ -->
        <Border x:Name="ProbeErrorPanel"
                Visibility="Collapsed"
                Background="{ThemeResource NeonPink20}"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xEA39;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="14"
                           Foreground="{ThemeResource NeonPinkBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ProbeErrorText"
                           Text="Failed to analyze URL."
                           FontSize="12"
                           Foreground="{ThemeResource NeonPinkBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  Auth Retry (shown when the probe error looks login-related) -->
        <!-- ============================================================ -->
        <StackPanel x:Name="AuthRetryPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
            <Button Content="Log In in Browser"
                    Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{ThemeResource TextSecondary}"
                    CornerRadius="{StaticResource CornerRadiusButton}"
                    Padding="16,10"
                    Click="LoginInBrowserButton_Click"/>
            <Button Content="I've Logged In — Retry"
                    Foreground="{ThemeResource NeonBlueBrush}"
                    Background="{ThemeResource NeonBlue20}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource CornerRadiusButton}"
                    Padding="16,10"
                    FontWeight="SemiBold"
                    Click="RetryAfterLoginButton_Click"/>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Probe Results (shown after successful HTTP probe)           -->
        <!-- ============================================================ -->
        <Border x:Name="ProbeResultsPanel"
                Visibility="Collapsed"
                Background="{ThemeResource BackgroundElevated}"
                BorderBrush="{ThemeResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <Grid RowSpacing="8" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filename -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Filename"
                           FontSize="12"
                           Foreground="{ThemeResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="FileNameTextBox"
                         Grid.Row="0" Grid.Column="1"
                         FontSize="13"
                         CornerRadius="8"/>

                <!-- Size -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Size"
                           FontSize="12"
                           Foreground="{ThemeResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FileSizeText"
                           Grid.Row="1" Grid.Column="1"
                           Text="Unknown"
                           Style="{StaticResource MonoTextStyle}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <!-- Range Support -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Range support"
                           FontSize="12"
                           Foreground="{ThemeResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <Border x:Name="RangeSupportBadge"
                        Grid.Row="2" Grid.Column="1"
                        CornerRadius="10"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource NeonAmber20}">
                    <TextBlock x:Name="RangeSupportText"
                               Text="Not Supported"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource NeonAmberBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!--  Video Info Panel (shown after successful yt-dlp probe)      -->
        <!-- ============================================================ -->
        <Border x:Name="VideoInfoPanel"
                Visibility="Collapsed"
                Background="{ThemeResource BackgroundSecondary}"
                BorderBrush="{ThemeResource NeonPurple20}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="16">
            <StackPanel Spacing="12">

                <!-- Header row: thumbnail + title/uploader/duration -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <Border Grid.Column="0"
                            Width="120" Height="68"
                            CornerRadius="4"
                            Background="{ThemeResource BackgroundElevated}">
                        <Image x:Name="VideoThumbnail"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Title + meta -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="VideoTitleText"
                                   Text="Video Title"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="VideoUploaderText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{ThemeResource TextSecondary}"/>
                            <Border x:Name="VideoDurationBadge"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Background="{ThemeResource NeonPurple20}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="VideoDurationText"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeonPurpleBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Format selector -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Quality / Format:"
                               Style="{StaticResource CaptionTextStyle}"/>
                    <ComboBox x:Name="FormatComboBox"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="FormatComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Estimated size for selected format -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Est. Size:"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VideoFileSizeText"
                               Text="Unknown"
                               Style="{StaticResource MonoTextStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- yt-dlp fallback toggle -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Use yt-dlp download"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextPrimary}"/>
                        <TextBlock Text="For HLS/DASH streams. Disables multi-segment acceleration."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="YtDlpFallbackToggle"
                                  Grid.Column="1"
                                  IsOn="False"
                                  VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  Save Location                                               -->
        <!-- ============================================================ -->
        <StackPanel Spacing="6">
            <TextBlock Text="SAVE TO"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="20"
                       Foreground="{ThemeResource TextSecondary}"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SavePathTextBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         FontFamily="Cascadia Code, Consolas"
                         FontSize="12"
                         CornerRadius="8"/>
                <Button Grid.Column="1"
                        Content="Browse"
                        Background="{ThemeResource BackgroundElevated}"
                        BorderBrush="{ThemeResource StrokeBrush}"
                        BorderThickness="1"
                        Foreground="{ThemeResource TextSecondary}"
                        CornerRadius="{StaticResource CornerRadiusButton}"
                        VerticalAlignment="Stretch"
                        Padding="16,6"
                        Click="BrowseSavePathButton_Click"/>
            </Grid>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Segment Count                                               -->
        <!-- ============================================================ -->
        <StackPanel Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="SEGMENTS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           CharacterSpacing="20"
                           Foreground="{ThemeResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{x:Bind SegmentSlider.Value, Mode=OneWay}"
                           Style="{StaticResource MonoTextStyle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource NeonBlueBrush}"
                           VerticalAlignment="Center"
                           MinWidth="20"
                           TextAlignment="Right"/>
            </Grid>
            <Slider x:Name="SegmentSlider"
                    Minimum="1"
                    Maximum="32"
                    Value="8"
                    StepFrequency="1"
                    SnapsTo="StepValues"
                    IsEnabled="False"
                    VerticalAlignment="Center"/>
            <Grid Margin="0,-8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="1"
                           FontSize="10"
                           FontFamily="Cascadia Code, Consolas"
                           Foreground="{ThemeResource TextDisabled}"/>
                <TextBlock Grid.Column="1"
                           Text="32"
                           FontSize="10"
                           FontFamily="Cascadia Code, Consolas"
                           Foreground="{ThemeResource TextDisabled}"/>
            </Grid>
        </StackPanel>

    </StackPanel>
</ContentDialog>
