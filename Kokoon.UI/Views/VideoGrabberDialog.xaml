<ContentDialog
    x:Class="Kokoon.UI.Views.VideoGrabberDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Download Video"
    SecondaryButtonText="Queue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    IsSecondaryButtonEnabled="False"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="&#xE714;" FontSize="18" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons"/>
            <TextBlock Text="Video Grabber" VerticalAlignment="Center"/>
        </StackPanel>
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <!--  ContentDialogMaxWidth must be overridden locally — the default (548) minus
              ContentDialogPadding only leaves 500px for content.  -->
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>

    <!--  MinWidth accounts for ContentDialogMaxWidth minus the dialog's border and
          padding, so content doesn't clip against the right edge.  -->
    <!--  Wrapped in a ScrollViewer with a fixed MaxHeight: once the video-info card and
          quality section are populated, unbounded content height pushes the dialog to
          fill the whole 900x600 app window with ~0px margin top/bottom (buttons rendered
          flush against the window edge). Capping content height keeps the dialog's own
          height constant so it always sits with normal breathing room above/below.  -->
    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MinWidth="510">

        <!-- ============================================================ -->
        <!--  URL Input                                                   -->
        <!-- ============================================================ -->
        <StackPanel Spacing="6">
            <TextBlock Text="URL"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="20"
                       Foreground="{ThemeResource TextSecondary}"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlTextBox"
                         Grid.Column="0"
                         PlaceholderText="https://youtube.com/watch?v=..."
                         FontFamily="Cascadia Code, Consolas"
                         FontSize="12"
                         CornerRadius="8"/>
                <Button Grid.Column="1"
                        Content="Probe"
                        Foreground="{ThemeResource NeonPurpleBrush}"
                        Background="{ThemeResource NeonPurple20}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource CornerRadiusButton}"
                        Padding="16,10"
                        FontWeight="SemiBold"
                        VerticalAlignment="Stretch"
                        Click="ProbeButton_Click"/>
            </Grid>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Loading Indicator (while probing)                           -->
        <!-- ============================================================ -->
        <StackPanel x:Name="ProbeLoadingPanel"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Padding="8">
            <ProgressRing IsActive="True"
                          Width="24"
                          Height="24"
                          Foreground="{ThemeResource NeonPurpleBrush}"/>
            <TextBlock Text="Probing video..."
                       Style="{StaticResource BodyTextStyle}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Error Message (shown on probe failure)                      -->
        <!-- ============================================================ -->
        <Border x:Name="ProbeErrorPanel"
                Visibility="Collapsed"
                Background="{ThemeResource NeonPink20}"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xEA39;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="14"
                           Foreground="{ThemeResource NeonPinkBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ProbeErrorText"
                           Text="Failed to probe URL."
                           FontSize="12"
                           Foreground="{ThemeResource NeonPinkBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  Auth Retry (shown when the probe error looks login-related) -->
        <!-- ============================================================ -->
        <StackPanel x:Name="AuthRetryPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
            <Button Content="Log In in Browser"
                    Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    Foreground="{ThemeResource TextSecondary}"
                    CornerRadius="{StaticResource CornerRadiusButton}"
                    Padding="16,10"
                    Click="LoginInBrowserButton_Click"/>
            <Button Content="I've Logged In — Retry"
                    Foreground="{ThemeResource NeonPurpleBrush}"
                    Background="{ThemeResource NeonPurple20}"
                    BorderThickness="0"
                    CornerRadius="{StaticResource CornerRadiusButton}"
                    Padding="16,10"
                    FontWeight="SemiBold"
                    Click="RetryAfterLoginButton_Click"/>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  Video Info Card (shown after successful yt-dlp probe)       -->
        <!-- ============================================================ -->
        <Border x:Name="VideoInfoPanel"
                Visibility="Collapsed"
                Background="{ThemeResource NeonPurple20}"
                BorderBrush="{ThemeResource NeonPurple20}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="12">
            <StackPanel Spacing="12">

                <!-- Thumbnail + title/uploader/views + duration+quality badges -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="120" Height="68"
                            CornerRadius="8"
                            Background="{ThemeResource BackgroundElevated}">
                        <Grid>
                            <TextBlock Text="video&#x0a;thumbnail"
                                       x:Name="ThumbnailPlaceholderText"
                                       FontSize="11"
                                       FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextDisabled}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image x:Name="VideoThumbnail" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="VideoTitleText"
                                   Text="Video Title"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="VideoUploaderText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{ThemeResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="VideoDurationBadge"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Background="{ThemeResource NeonPurple20}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="VideoDurationText"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeonPurpleBrush}"/>
                            </Border>
                            <Border x:Name="VideoQualityBadge"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Background="{ThemeResource NeonTeal20}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="VideoQualityText"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeonTealBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  Quality chip selector                                       -->
        <!-- ============================================================ -->
        <StackPanel x:Name="QualitySection" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="QUALITY"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="20"
                       Foreground="{ThemeResource TextSecondary}"/>
            <ComboBox x:Name="QualityComboBox"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="QualityComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  yt-dlp fallback toggle                                      -->
        <!-- ============================================================ -->
        <Grid Padding="16,12"
              Background="{ThemeResource BackgroundElevated}"
              BorderBrush="{ThemeResource StrokeBrush}"
              BorderThickness="1"
              CornerRadius="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Use yt-dlp download"
                           FontSize="12"
                           Foreground="{ThemeResource TextPrimary}"/>
                <TextBlock Text="For HLS/DASH streams. Disables multi-segment acceleration."
                           FontSize="11"
                           Foreground="{ThemeResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="YtDlpFallbackToggle"
                          Grid.Column="1"
                          IsOn="False"
                          VerticalAlignment="Center"/>
        </Grid>

    </StackPanel>
    </ScrollViewer>
</ContentDialog>
