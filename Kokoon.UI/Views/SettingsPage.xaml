<Page
    x:Class="Kokoon.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,32">
        <StackPanel MaxWidth="700"
                    HorizontalAlignment="Center"
                    Margin="24,0">

            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{ThemeResource TextPrimary}"
                       Margin="0,24,0,20"/>

            <!-- ============================================================ -->
            <!--  SECTION 1: Downloads                                        -->
            <!-- ============================================================ -->
            <TextBlock Text="DOWNLOADS"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,0,0,10"/>

            <Border Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Margin="0,0,0,24">
                <StackPanel>

                    <!-- Default Save Path -->
                    <Border Padding="18,14" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Default Save Path"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SavePathTextBox"
                                         Grid.Column="0"
                                         Text="{x:Bind DefaultSavePath, Mode=OneWay}"
                                         PlaceholderText="Select download folder..."
                                         IsReadOnly="True"
                                         FontFamily="Cascadia Code, Consolas"
                                         FontSize="12"/>
                                <Button Grid.Column="1"
                                        Content="Open"
                                        Style="{StaticResource NeonButtonStyle}"
                                        CornerRadius="7"
                                        Click="OpenSavePathButton_Click"
                                        VerticalAlignment="Stretch"
                                        Padding="14,6"/>
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource NeonButtonStyle}"
                                        CornerRadius="7"
                                        Click="BrowseFolderButton_Click"
                                        VerticalAlignment="Stretch"
                                        Padding="14,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Default Segment Count -->
                    <Border Padding="18,14" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Default Segment Count"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind SegmentCountSlider.Value, Mode=OneWay}"
                                           Style="{StaticResource MonoTextStyle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource NeonBlueBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Number of parallel connections (1-32)"
                                       Style="{StaticResource CaptionTextStyle}"/>
                            <Slider x:Name="SegmentCountSlider"
                                    Minimum="1"
                                    Maximum="32"
                                    Value="8"
                                    StepFrequency="1"
                                    SnapsTo="StepValues"/>
                        </StackPanel>
                    </Border>

                    <!-- Start with Windows -->
                    <Border Padding="18,14" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <ToggleSwitch x:Name="AutoStartToggle"
                                      Header="Start Kokoon with Windows"
                                      OnContent="On"
                                      OffContent="Off"/>
                    </Border>

                    <!-- Minimize to Tray -->
                    <Border Padding="18,14">
                        <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                      Header="Minimize to tray on close"
                                      OnContent="On"
                                      OffContent="Off"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!--  SECTION 2: Speed                                            -->
            <!-- ============================================================ -->
            <TextBlock Text="SPEED"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,0,0,10"/>

            <Border Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Margin="0,0,0,24">
                <Border Padding="18,14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Global Speed Limit"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SpeedLimitSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    StepFrequency="1"
                                    SnapsTo="StepValues"
                                    VerticalAlignment="Center"/>
                            <TextBox x:Name="SpeedLimitTextBox"
                                     Grid.Column="1"
                                     Text="{x:Bind SpeedLimitSlider.Value, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Width="60"
                                     TextAlignment="Center"
                                     FontFamily="Cascadia Code, Consolas"
                                     FontSize="13"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="MB/s"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="0 = Unlimited"
                                   Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================================ -->
            <!--  SECTION 3: Video Grabber                                    -->
            <!-- ============================================================ -->
            <TextBlock Text="VIDEO GRABBER"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,0,0,10"/>

            <Border Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Margin="0,0,0,24">
                <StackPanel>

                    <!-- Preferred Video Quality -->
                    <Border Padding="18,14" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Preferred Video Quality"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="Default quality when downloading videos"
                                       Style="{StaticResource CaptionTextStyle}"/>
                            <ComboBox x:Name="VideoQualityComboBox"
                                      MinWidth="200">
                                <ComboBoxItem Content="Best available" Tag="Best"/>
                                <ComboBoxItem Content="1080p (Full HD)" Tag="FullHD1080"/>
                                <ComboBoxItem Content="720p (HD)" Tag="HD720"/>
                                <ComboBoxItem Content="480p (SD)" Tag="SD480"/>
                                <ComboBoxItem Content="360p" Tag="SD360"/>
                                <ComboBoxItem Content="Audio only" Tag="AudioOnly"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- yt-dlp Fallback -->
                    <Border Padding="18,14" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="YtDlpFallbackToggle"
                                          Header="Allow yt-dlp full download"
                                          OnContent="On"
                                          OffContent="Off"
                                          IsOn="True"/>
                            <TextBlock Text="Falls back to yt-dlp for HLS/DASH streams that can't use the segment engine"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-detect Video URLs -->
                    <Border Padding="18,14">
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="AutoDetectVideoToggle"
                                          Header="Auto-detect video URLs"
                                          OnContent="On"
                                          OffContent="Off"
                                          IsOn="True"/>
                            <TextBlock Text="Automatically probe URLs for video content in the Add Download dialog"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!--  SECTION 4: Appearance                                       -->
            <!-- ============================================================ -->
            <TextBlock Text="APPEARANCE"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,0,0,10"/>

            <Border Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Margin="0,0,0,24">
                <StackPanel>

                    <!-- Base mode (Dark / Light / System) — 3-pill segmented control. -->
                    <Border Padding="18,14" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Theme"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ThemePillDark"
                                        Tag="0"
                                        Content="Dark"
                                        Style="{StaticResource ThemePillButtonStyle}"
                                        Click="ThemeModePill_Click"/>
                                <Button x:Name="ThemePillLight"
                                        Tag="1"
                                        Content="Light"
                                        Style="{StaticResource ThemePillButtonStyle}"
                                        Click="ThemeModePill_Click"/>
                                <Button x:Name="ThemePillSystem"
                                        Tag="2"
                                        Content="System"
                                        Style="{StaticResource ThemePillButtonStyle}"
                                        Click="ThemeModePill_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Segment Color Visualization -->
                    <Border Padding="18,14">
                        <ToggleSwitch x:Name="SegmentColorsToggle"
                                      Header="Show segment color visualization"
                                      OnContent="On"
                                      OffContent="Off"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!--  SECTION 5: About                                            -->
            <!-- ============================================================ -->
            <TextBlock Text="ABOUT"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,0,0,10"/>

            <Border Background="{ThemeResource BackgroundElevated}"
                    BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusCard}"
                    Padding="18,14"
                    Margin="0,0,0,32">
                <StackPanel Spacing="8">
                    <TextBlock Text="Kokoon Downloader"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource NeonBlueBrush}"/>
                    <TextBlock Text="Version 1.0.0-preview"
                               FontSize="13"
                               Foreground="{ThemeResource TextSecondary}"/>
                    <HyperlinkButton Content="View on GitHub"
                                     NavigateUri="https://github.com/kokoon-downloader/kokoon"
                                     Foreground="{ThemeResource NeonBlueBrush}"
                                     Padding="0,4"/>
                    <TextBlock Text="MIT License"
                               FontSize="12"
                               Foreground="{ThemeResource TextDisabled}"
                               Margin="0,0,0,24"/>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!--  SAVE BUTTON                                                -->
            <!-- ============================================================ -->
            <Button x:Name="SaveButton"
                    Content="Save Settings"
                    Style="{StaticResource NeonButtonPrimaryStyle}"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Padding="0"
                    Margin="0,0,0,32"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>
