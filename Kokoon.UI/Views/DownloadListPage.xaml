<Page
    x:Class="Kokoon.UI.Views.DownloadListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kokoon.UI.ViewModels"
    xmlns:converters="using:Kokoon.UI.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ProgressToPercentConverter x:Key="ProgressToPercentConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </Page.Resources>

    <!-- Root Grid fills the page -->
    <Grid>
        <ListView ItemsSource="{x:Bind Downloads, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  Padding="8">

            <!-- Remove default selection/hover chrome from ListViewItem -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">

                    <!-- ====================================================== -->
                    <!--  Download Card                                         -->
                    <!-- ====================================================== -->
                    <Border Background="#12121A"
                            BorderBrush="#2A2A3F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ============================================== -->
                            <!--  Row 0 — Header: icon + filename + actions     -->
                            <!-- ============================================== -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Icon + Filename -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileIconGlyph, Mode=OneWay}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="22"
                                               Foreground="#00D4FF"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#F0F0FF"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Right: Action Buttons -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="4">

                                    <!-- Pause (visible when active) -->
                                    <Button Width="30" Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind PauseCommand}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Pause">
                                        <TextBlock Text="&#xE769;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="12"
                                                   Foreground="#7A7A9A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Resume (visible when paused) -->
                                    <Button Width="30" Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ResumeCommand}"
                                            Visibility="{x:Bind IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Resume">
                                        <TextBlock Text="&#xE768;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="12"
                                                   Foreground="#7A7A9A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Cancel -->
                                    <Button Width="30" Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind CancelCommand}"
                                            ToolTipService.ToolTip="Cancel">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="12"
                                                   Foreground="#7A7A9A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Retry (visible when failed/cancelled) -->
                                    <Button Width="30" Height="30"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind RetryCommand}"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="Retry">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="12"
                                                   Foreground="#7A7A9A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ============================================== -->
                            <!--  Row 1 — Details: domain, size, status badge   -->
                            <!-- ============================================== -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: domain + separator + file size -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DomainText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#7A7A9A"/>
                                    <TextBlock Text=" &#x2022; "
                                               FontSize="12"
                                               Foreground="#3A3A5A"
                                               Margin="6,0"/>
                                    <TextBlock Text="{x:Bind FileSizeText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#7A7A9A"/>
                                </StackPanel>

                                <!-- Right: Status badge -->
                                <Border Grid.Column="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Background="#1A1A28"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind StatusColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                                </Border>
                            </Grid>

                            <!-- ============================================== -->
                            <!--  Row 2 — Progress bar + stats                  -->
                            <!-- ============================================== -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Progress bar -->
                                <ProgressBar Grid.Column="0"
                                             Value="{x:Bind Progress, Mode=OneWay, Converter={StaticResource ProgressToPercentConverter}}"
                                             Maximum="100"
                                             Height="4"
                                             CornerRadius="2"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0">
                                    <ProgressBar.Background>
                                        <SolidColorBrush Color="#1A1A28"/>
                                    </ProgressBar.Background>
                                    <ProgressBar.Foreground>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#00D4FF" Offset="0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ProgressBar.Foreground>
                                </ProgressBar>

                                <!-- Stats: percentage, speed, ETA -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#7A7A9A"
                                               FontFamily="Cascadia Code, Consolas"
                                               Width="45"
                                               TextAlignment="Right"/>
                                    <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#00D4FF"
                                               FontFamily="Cascadia Code, Consolas"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Text="{x:Bind EtaText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#7A7A9A"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ============================================== -->
                            <!--  Row 3 — Segment visualization                 -->
                            <!-- ============================================== -->
                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Segment bars -->
                                <ItemsControl Grid.Column="0"
                                              ItemsSource="{x:Bind Segments, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SegmentViewModel">
                                            <Grid Height="6" MinWidth="20" Margin="1,0">
                                                <!-- Track (empty) -->
                                                <Border CornerRadius="1" Background="#2A2A3F"/>
                                                <!-- Fill (progress) -->
                                                <Border CornerRadius="1"
                                                        Background="{x:Bind SegmentColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                                        Opacity="{x:Bind Progress, Mode=OneWay}"
                                                        HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Segment count label -->
                                <TextBlock Grid.Column="1"
                                           FontSize="11"
                                           Foreground="#3A3A5A"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0">
                                    <Run Text="{x:Bind Segments.Count, Mode=OneWay}"/>
                                    <Run Text=" segs"/>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
