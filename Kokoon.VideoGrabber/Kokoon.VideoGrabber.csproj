<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kokoon.VideoGrabber</RootNamespace>
    <AssemblyName>Kokoon.VideoGrabber</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kokoon.Core\Kokoon.Core.csproj" />
  </ItemGroup>

  <!-- Bundle yt-dlp.exe and ffmpeg.exe as content files -->
  <ItemGroup>
    <None Update="tools\yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Update="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
